<?xml version="1.0" encoding="UTF-8"?>
<!-- JVM tests for the native app, run with Robolectric (real Android framework
     code, no device). Build the APK first (../build.sh), then: mvn -q test -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.jahangirb</groupId>
  <artifactId>pmpprep-tests</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <android.jar>${env.ANDROID_JAR}</android.jar>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.google.android</groupId>
      <artifactId>android-stubs</artifactId>
      <version>34</version>
      <scope>system</scope>
      <systemPath>${android.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>android-all-instrumented</artifactId>
      <version>14-robolectric-10818077-i7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>android-all-instrumented</artifactId>
      <version>15-robolectric-12650502-i7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>robolectric</artifactId>
      <version>4.14.1</version>
      <scope>test</scope>
      <!-- Only served from Google's Maven; java/androidx holds the few stand-ins Robolectric touches. -->
      <exclusions>
        <exclusion><groupId>androidx.test</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>androidx.test.espresso</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>../src</sourceDirectory>
    <testSourceDirectory>java</testSourceDirectory>
    <testResources>
      <testResource><directory>resources</directory></testResource>
    </testResources>
    <plugins>
      <!-- Robolectric's own downloader gets rate-limited; let Maven fetch the framework jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>process-test-resources</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeArtifactIds>android-all-instrumented</includeArtifactIds>
              <outputDirectory>${project.build.directory}/android-all</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <robolectric.logging>stdout</robolectric.logging>
            <robolectric.offline>true</robolectric.offline>
            <robolectric.enabledSdks>34</robolectric.enabledSdks>
            <robolectric.dependency.dir>${project.build.directory}/android-all</robolectric.dependency.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
